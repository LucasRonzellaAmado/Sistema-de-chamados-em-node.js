<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Entrar :: Painel de Chamados</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" referrerpolicy="no-referrer">
<link rel="stylesheet" href="/css/estilo.css">
</head>
<body class="pagina-login">
  <div class="caixa-login">
    <div class="marca-login">
      <span class="logo-icone logo-grande"><i class="fa-solid fa-headset"></i></span>
      <h1>Painel de Chamados</h1>
    </div>
    <p class="subtitulo">Entre com seu e-mail e senha</p>

    <% if (erro) { %>
      <div class="alerta alerta-erro"><i class="fa-solid fa-triangle-exclamation"></i> <%= erro %></div>
    <% } %>

    <form action="/login" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label for="email">E-mail</label>
      <input type="email" id="email" name="email" required autofocus autocomplete="username" maxlength="254">

      <label for="senha">Senha</label>
      <input type="password" id="senha" name="senha" required autocomplete="current-password" maxlength="128">

      <button type="submit" class="botao botao-primario botao-bloco">Entrar</button>
    </form>

    <p class="rodape-login">Ainda não tem conta? <a href="/cadastro">Cadastre-se como cliente</a></p>

    <% if (mostrarUsuariosTeste) { %>
    <div class="dica-caixa">
      <strong>Usuários de teste (senha: 123456) — somente em desenvolvimento</strong>
      <ul>
        <li>admin@empresa.com — Administrador</li>
        <li>davi@empresa.com — Técnico de Suporte</li>
        <li>phenrir@empresa.com — Técnico de Infraestrutura</li>
        <li>financeiro@empresa.com — Técnico Financeiro</li>
        <li>lucas@empresa.com — Técnico de Desenvolvimento</li>
        <li>cliente@empresa.com — Cliente</li>
      </ul>
    </div>
    <% } %>
  </div>
</body>
</html>
